{
  "name": "bbdmslr",
  "private": true,
  "version": "0.3.0",
  "description": "An open source browser client for BDSMLR.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zastraeaxyz/bdsmlr.git"
  },
  "homepage": "https://github.com/Zastraeaxyz/bdsmlr#readme",
  "bugs": {
    "url": "https://github.com/Zastraeaxyz/bdsmlr/issues"
  },
  "scripts": {
    "predev": "pnpm db:migrate",
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite start",
    "preview": "vite preview",
    "swagger:fetch": "./scripts/fetch-swagger.sh",
    "swagger:generate": "swagger-typescript-api generate -p src/lib/api/openapi.json -o src/lib/api -n client.ts --modular --axios",
    "swagger:update": "npm run swagger:fetch && npm run swagger:generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "notify:changelog": "tsx scripts/notify-changelog.ts",
    "test": "vitest run",
    "prestart": "pnpm db:migrate"
  },
  "dependencies": {
    "@corvu/drawer": "^0.2.4",
    "@corvu/resizable": "^0.2.5",
    "@kobalte/core": "^0.13.14",
    "@libsql/client": "^0.17.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "2.0.0-alpha.2",
    "@solidjs/vite-plugin-nitro-2": "^0.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "cmdk-solid": "^1.2.0",
    "cva": "1.0.0-beta.12",
    "drizzle-orm": "^0.45.1",
    "lucide-solid": "^1.77.0",
    "rss": "^1.2.2",
    "solid-js": "^1.9.12",
    "somoto": "^0.0.2",
    "systray": "^1.0.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/rss": "^0.0.32",
    "drizzle-kit": "^0.31.8",
    "postject": "1.0.0-alpha.6",
    "swagger-typescript-api": "^13.12.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
